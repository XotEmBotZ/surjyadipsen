   code="C4Deployment\ntitle Self-Hosted Infrastructure\n\nPerson(user, \"User\", \"Accesses services\")\n\nDeployment_Node(vps, \"VPS Host\", \"Linux\") {\n\n    Deployment_Node(docker, \"Docker Engine\", \"Docker\") {\n\n        Container(traefik, \"Traefik\", \"Reverse Proxy\", \"Central ingress router\")\n\n        Deployment_Node(mc, \"Minecraft Stack\", \"Docker Network\") {\n\n            Container(velocity, \"Velocity Proxy\", \"Minecraft Proxy\", \"Routes players\")\n            \n            Container(sv1, \"Game Server 1\", \"Paper Server\")\n            Container(sv2, \"Game Server 2\", \"Paper Server\")\n\n            ContainerDb(psql, \"PostgreSQL\", \"Database\")\n\n            Rel(velocity, sv1, \"Routes players\")\n            Rel(velocity, sv2, \"Routes players\")\n\n            Rel(sv1, psql, \"Reads/Writes\")\n            Rel(sv2, psql, \"Reads/Writes\")\n            Rel(velocity, psql, \"Reads/Writes\")\n        }\n\n        Deployment_Node(pngx, \"Paperless-ngx Stack\", \"Docker Network\") {\n\n            Container(pweb, \"Paperless Webserver\", \"Web App\")\n\n            ContainerDb(pdb, \"Database\", \"PostgreSQL\")\n\n            Container(queue, \"Message Broker\", \"Redis\")\n\n            Container(tika, \"Apache Tika\", \"Text Extraction\")\n\n            Container(gotenberg, \"Gotenberg\", \"PDF Service\")\n\n            Rel(pweb, pdb, \"Reads/Writes\")\n            Rel(pweb, queue, \"Queues jobs\")\n\n            Rel(queue, tika, \"Extracts text\")\n            Rel(queue, gotenberg, \"Converts PDFs\")\n        }\n\n        Deployment_Node(ab, \"Actual Budget Stack\", \"Docker Network\") {\n\n            Container(abweb, \"Actual Budget Server\", \"Finance App\")\n        }\n\n        Deployment_Node(rr, \"Reactive Resume Stack\", \"Docker Network\") {\n\n            Container(rrweb, \"Reactive Resume\", \"Web App\")\n\n            ContainerDb(rrdb, \"Database\", \"PostgreSQL\")\n\n            Container(rrpdf, \"PDF Printer\", \"Renderer\")\n\n            Rel(rrweb, rrdb, \"Reads/Writes\")\n            Rel(rrweb, rrpdf, \"Generates PDFs\")\n        }\n    }\n}\n\nRel(user, traefik, \"HTTPS\")\n\nRel(traefik, velocity, \"Minecraft Routing\")\nRel(traefik, pweb, \"HTTPS Routing\")\nRel(traefik, abweb, \"HTTPS Routing\")\nRel(traefik, rrweb, \"HTTPS Routing\")\n\nUpdateElementStyle(user, $bgColor=\"#059669\", $fontColor=\"white\", $borderColor=\"#10b981\")\n\nUpdateElementStyle(traefik, $bgColor=\"#1f2937\", $fontColor=\"white\", $borderColor=\"#3b82f6\")\n\nUpdateElementStyle(psql, $bgColor=\"#1e293b\", $fontColor=\"white\")\nUpdateElementStyle(pdb, $bgColor=\"#1e293b\", $fontColor=\"white\")\nUpdateElementStyle(rrdb, $bgColor=\"#1e293b\", $fontColor=\"white\")\n\nUpdateLayoutConfig($c4ShapeInRow=\"2\", $c4BoundaryInRow=\"2\")" /%}
